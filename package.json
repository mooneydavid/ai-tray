{
  "name": "ai-tray",
  "version": "1.2.4",
  "description": "Windows tray app showing your Claude, ChatGPT/Codex and Grok usage limits",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "author": "David Mooney",
  "license": "MIT",
  "homepage": "https://github.com/mooneydavid/ai-tray",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mooneydavid/ai-tray.git"
  },
  "bugs": {
    "url": "https://github.com/mooneydavid/ai-tray/issues"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.david.ai-tray",
    "productName": "AI Tray",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "files": [
      "main.js",
      "preload.js",
      "providers/**",
      "src/**",
      "assets/**",
      "package.json"
    ]
  }
}
